PORT=5000
NODE_ENV=development
# Set your MongoDB Atlas or local MongoDB URI.
# If left blank or unreachable, FoodSwift will automatically initialize MongoMemoryServer!
MONGODB_URI=mongodb://127.0.0.1:27017/foodswift
JWT_SECRET=foodswift_super_secret_jwt_key_salem_2026
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
COOKIE_SECRET=foodswift_cookie_secret_9988

# Razorpay Test Mode Credentials (Optional - test simulator active if blank)
RAZORPAY_KEY_ID=rzp_test_foodswift_demo
RAZORPAY_KEY_SECRET=rzp_test_secret_foodswift_demo
RAZORPAY_WEBHOOK_SECRET=foodswift_webhook_secret_2026

# Cloudinary (Optional)
